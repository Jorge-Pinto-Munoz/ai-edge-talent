# Copiar a .env.local (nunca commitear .env.local) o configurar en el hosting (Vercel, etc.).
# URL del proyecto: sin /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_…): pública por diseño
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…): SOLO servidor
SUPABASE_SECRET_KEY=
# IA (Claude): evaluación del Assessment, respuestas de Ayuda y síntesis de pulsos. Ver docs/decisiones/ia-en-la-plataforma.md
ANTHROPIC_API_KEY=
# Correos: Resend por API REST (la llave solo en el servidor, nunca en el navegador).
RESEND_API_KEY=
# Sin RESEND_FROM se usa el remitente de prueba "AI Edge Talent <onboarding@resend.dev>". En ese modo Resend solo
# entrega al correo dueño de la cuenta: TODO correo se redirige a RESEND_TEST_TO, indicando a quién iba dirigido.
RESEND_TEST_TO=
# Con un dominio verificado en Resend (p. ej. "AI Edge Talent <avisos@midominio.cl>") se entrega a cada destinatario.
RESEND_FROM=
# URL pública de la app (para enlaces en correos y magic links)
APP_URL=http://localhost:3000

# Soporte: a dónde llegan las preguntas del botón Ayuda (separa varios con coma). Si falta, llegan a los admin.
SUPPORT_EMAIL=

# Identidad (/ingresar): correo + código personal de 4 dígitos (hash scrypt), códigos temporales por correo (Resend).
# Sin RESEND_API_KEY no salen activaciones, restablecimientos, la verificación de admin ni recordatorios:
# quedan registrados como "failed" en email_messages (y el ingreso por enlace mágico de /login sigue disponible).
# Opcional: dominios corporativos permitidos para cuentas Delivery/admin (separados por coma; vacío = sin filtro).
STAFF_EMAIL_DOMAINS=
# Recomendado: secreto propio para el HMAC de los códigos temporales e IP (si falta, se usa la llave de servicio).
STAFF_CODE_SECRET=

# Recordatorios de pulsos de cierre: Vercel Cron llama /api/cron/recordatorios a diario (vercel.json)
# con "Authorization: Bearer $CRON_SECRET". Sin CRON_SECRET el endpoint responde 503 y no envía nada.
CRON_SECRET=
